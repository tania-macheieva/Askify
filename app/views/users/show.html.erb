<div class="container profile-container">
  <div class="profile-header">
    <div class="avatar-container">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, alt: @user.name, class: "profile-avatar" %>
      <% else %>
        <%= @user.nickname.first.upcase %>
      <% end %>
    </div>

    <div class="profile-user-info mt-lg">
      <h2 class="title-lg text-bold mt-lg"><%= @user.name %></h2>
      <h2 class="title-sm text-dark mb"><%= @user.nickname %></h2>

      <% if @user.position.present? %>
        <p class="text-dark text-bold mt-lg"><%= @user.position %></p>
      <% end %>

      <div class="profile-social-links mt mb">
        <% if current_user == @user %>
          <button id="copy-email" class="social-button email" data-email="<%= @user.email %>">
            <i class="fa-solid fa-envelope"></i>
            <span id="email-text"><%= @user.email %></span>
          </button>
        <% end %>
        <%= render 'social_link', url: @user.github_url, validator: method(:safe_github_url), platform: "github", icon: "github", label: "GitHub" %>
        <%= render 'social_link', url: @user.linkedin_url, validator: method(:safe_linkedin_url), platform: "linkedin", icon: "linkedin-in", label: "LinkedIn" %>
      </div>

      <% if current_user == @user %>
        <%= link_to 'Edit Profile', edit_user_path(@user), class: 'button button-main mt' %>
      <% end %>
    </div>
  </div>
  
  <% if @user.education.present? || @user.experience.present? || @user.tech_stack.present? || @user.languages.present? %>
    <div class="profile-career-section mt-lg">
      <% if @user.education.present? %>
        <div class="profile-education mb">
          <h4 class="section-title mb-sm">
            <i class="fa-solid fa-graduation-cap mr-sm"></i> Education
          </h4>
          <p><%= @user.education %></p>
        </div>
      <% end %>

      <% if @user.experience.present? %>
        <div class="profile-experience mb">
          <h4 class="section-title mb-sm">
            <i class="fa-solid fa-suitcase mr-sm"></i> Experience
          </h4>
          <p><%= @user.experience %></p>
        </div>
      <% end %>

      <% if @user.tech_stack.present? %>
        <div class="profile-tech-stack mb">
          <h4 class="section-title mb-sm">
            <i class="fa-solid fa-laptop mr-sm"></i> Tech Stack
          </h4>
          <p><%= @user.tech_stack %></p>
        </div>
      <% end %>

      <% if @user.languages.present? %>
        <div class="profile-languages mb-md">
          <h4 class="section-title mb-sm">
            <i class="fa-solid fa-globe mr-sm"></i> Languages
          </h4>
          <p><%= @user.languages %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="profile-questions-section">
    <%= render 'questions/form', question: @new_question %>

    <h4 class="section-title mb-sm">
      <%= @received_questions.count %>
      <%= question_count_text(@received_questions.count) %>
    </h4>
    
    <div class="user-search-container">
      <%= form_with url: user_path(@user, anchor: 'questions-list'), method: :get, local: true, class: "user-search-form" do |form| %>
        <div class="search-input-group">
          <div class="search-input-wrapper">
            <span class="search-icon"><i class="fas fa-search"></i></span>
            <%= form.text_field :search,
                value: params[:search],
                placeholder: "Search questions or answers by keyword...",
                class: "form-text-field search-input" %>
          </div>
          <%= form.submit "Search", class: "button button-secondary" %>
          <% if params[:search].present? %>
            <%= link_to "Clear", request.path, class: "button button-cancel" %>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <div id="questions-list">
      <% @received_questions.each do |question| %>
        <div class="question-container">
          <div class="question-block" id="question-<%= question.id %>">
            <%= render 'questions/question', question: question %>
            
            <% if question.receiver == current_user && question.answer.blank? %>
              <div class="mt-lg ml-45">
                <button type="button" class="button button-main show-answer-form-btn" data-question-id="<%= question.id %>">
                  Answer Question
                </button>
                <div id="answer-form-<%= question.id %>" class="answer-form mt-sm" style="display: none;">
                  <%= form_with model: question, url: answer_question_path(question), method: :patch, local: false do |f| %>
                    <%= f.text_area :answer, placeholder: "Enter your answer...", class: "form-text-area mb-sm" %>
                    <div class="form-buttons">
                      <%= f.submit "Надіслати відповідь", class: "button button-main" %>
                      <button type="button" class="button  cancel-answer-btn" 
                              data-question-id="<%= question.id %>">Cancel</button>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
            
            <% if question.answer.present? %>
              <div class="answer-container mt p-sm rounded bg-light">
                <div class="flex space-x">
                  <div>
                    <% if question.receiver.avatar.attached? %>
                      <%= image_tag question.receiver.avatar, class: "avatar" %>
                    <% else %>
                      <div class="avatar avatar-initial"><%= question.receiver.nickname.first.upcase %></div>
                    <% end %>
                  </div>

                  <div class="full-width">
                    <p class="text-dark"><%= question.answer %></p>
                    <div class="text-sm text-grey">
                      <%= question.updated_at.present? ? "Answered: #{l(question.updated_at, format: :short)}" : "No timestamp" %>
                    </div>
                  </div>
                </div>
                
                <% if question.receiver == current_user %>
                  <div class="question-btns mt-xs">
                    <button type="button" class="edit-answer-btn" 
                            data-question-id="<%= question.id %>" 
                            title="Edit answer">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </button>

                    <%= button_to fa_icon('trash'), remove_answer_question_path(question), 
                        method: :delete, 
                        data: { confirm: "Are you sure you want to delete this answer?" },
                        class: 'delete-button', 
                        title: "Delete answer",
                        form: { data: { turbo_method: :delete } } %>
                  </div>
                <% end %>
              </div>
              
              <% if question.receiver == current_user %>
                <div id="edit-answer-form-<%= question.id %>" class="edit-answer-form" style="display: none;">
                  <%= form_with model: question, url: answer_question_path(question), method: :patch, local: false do |f| %>
                    <%= f.text_area :answer, value: question.answer, class: "form-text-area  mb-sm", rows: 4 %>
                    <div class="form-buttons">
                      <%= f.submit "Save Answer", class: "button button-main" %>
                      <button type="button" class="button cancel-edit-btn button-cancel" 
                              data-question-id="<%= question.id %>">Cancel</button>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>